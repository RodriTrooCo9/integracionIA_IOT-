# ==========================================
# Configuración del Sistema IoT-PID-IA Papa
# Copiar a .env y ajustar según sea necesario
# ==========================================

# Broker MQTT (Eclipse Mosquitto)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USER=invernadero_admin
MQTT_PASSWORD=TesisPapaLaPaz2026!

# Base de Datos de Series Temporales (InfluxDB v2)
INFLUXDB_VERSION=2.7
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin_invernadero
INFLUXDB_PASSWORD=TesisPapaPass2026!
INFLUXDB_ORG=agri_iot_tesis
INFLUXDB_BUCKET=invernadero_data
INFLUXDB_TOKEN=my-super-secret-admin-auth-token-tesis-2026-lapaz-bolivia

# Visualización y Métricas (Grafana)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_tesis_grafana

# Servidor Backend (FastAPI)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=clave_secreta_jwt_fastapi_invernadero_2026

# Alertas Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_bot_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# Parámetros Agronómicos Base (Cultivo de Papa - La Paz)
SETPOINT_TEMP_DIA=20.0
SETPOINT_TEMP_NOCHE=14.0
SETPOINT_HUMEDAD=75.0
SETPOINT_HUMEDAD_SUELO=65.0
UMBRAL_VPD_ALTO=1.4
UMBRAL_VPD_BAJO=0.4
